# Example — copy to `secrets.toml` (gitignored) for local runs.
# Streamlit Community Cloud: App → Settings → Secrets — paste TOML there (never commit keys).
# Replace placeholders; never commit real keys.
#
# Optional manufacturing audit tuning (also set as real env vars on the host):
# CLEARSPEND_EMBEDDED_FEE_RATE = "0.009363"   # if Total = (Invoice+Tax)×(1+fee)
# CLEARSPEND_EXPECTED_TAX_RATE = "0.08"       # fixed tax benchmark; omit to use dataset median rate
# CLEARSPEND_PRICE_DRIFT_MIN_GROUP = "30"

# Flat keys (recommended for Cloud — simplest):
ANTHROPIC_API_KEY = ""
OPENAI_API_KEY = ""

# Optional: group under [llm] — main.py resolves these too:
# [llm]
# ANTHROPIC_API_KEY = ""
# OPENAI_API_KEY = ""

# Optional namespaced env vars on the host (no secrets file):
# CLEARSPEND_ANTHROPIC_API_KEY
# CLEARSPEND_OPENAI_API_KEY
